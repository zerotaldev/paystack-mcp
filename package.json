{
  "name": "paystack-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Paystack payments API. Test mode by default, enforced from the key prefix.",
  "type": "module",
  "license": "MIT",
  "author": "Siphesihle Mbili",
  "homepage": "https://github.com/zerotaldev/paystack-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerotaldev/paystack-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zerotaldev/paystack-mcp/issues"
  },
  "mcpName": "io.github.zerotaldev/paystack",
  "bin": {
    "paystack-mcp": "src/index.mjs"
  },
  "files": [

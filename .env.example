# Secret key from the Paystack dashboard: Settings > API Keys & Webhooks.
# The PREFIX decides the mode. sk_test_ is test mode and spends nothing.
PAYSTACK_SECRET_KEY=sk_test_

# Only needed when the key above is an sk_live_ key. Without it, a live key
# refuses to start rather than running unnoticed against real money.
# PAYSTACK_ALLOW_LIVE=i-understand-this-moves-real-money

# Default currency: NGN, ZAR, GHS, KES, USD or XOF.
PAYSTACK_CURRENCY=ZAR

# Ceiling on a single transaction, in MAJOR units (rands, not cents).
PAYSTACK_MAX_AMOUNT=1000
